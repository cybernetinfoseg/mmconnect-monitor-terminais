{
  "name": "NOC Monitor \u2014 Limpar dados ao excluir terminal",
  "description": "Quando um terminal \u00e9 exclu\u00eddo, apaga automaticamente todos os seus incidentes, cache de status, escalation alerts e logs de opera\u00e7\u00e3o.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "delete"
      ],
      "entity_name": "Terminal"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "noc_monitor_limpar_dados_ao_excluir_terminal",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onTerminalDeleted",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onTerminalDeleted"
  }
}